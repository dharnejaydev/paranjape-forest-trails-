
---
const stats = [
  {
    number: "90%",
    label: "Open Spaces",
    detail: "A greener township environment",
    icon: "leaf",
  },
  {
    number: "190+",
    label: "Acres Township",
    detail: "A larger township setting",
    icon: "landmark",
  },
  {
    number: "2–5 BHK",
    label: "Home Configurations",
    detail: "Apartments and bungalow options",
    icon: "house",
  },
  {
    number: "10+",
    label: "Lifestyle Amenities",
    detail: "Spaces for recreation and wellness",
    icon: "sparkles",
  },
];
---

<section class="ft-stats" aria-label="Forest Trails project highlights">

  <div class="ft-stats-container">

    <div class="ft-stats-grid">

      {stats.map((stat, index) => (
        <article class="ft-stat-card">

          <div class="ft-stat-icon-wrap">
            <div class="ft-stat-icon">

              {stat.icon === "leaf" && (
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <path d="M39 8C22 8 10 14 10 28c0 7 5 11 11 11C35 39 40 23 39 8Z" />
                  <path d="M8 42c6-12 14-18 24-25" />
                  <path d="M19 29c-1-5-4-8-8-10" />
                </svg>
              )}

              {stat.icon === "landmark" && (
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <path d="M5 19 24 6l19 13" />
                  <path d="M9 18v23h30V18" />
                  <path d="M16 41V25h16v16" />
                  <path d="M19 25v-5h10v5" />
                  <path d="M4 44h40" />
                </svg>
              )}

              {stat.icon === "house" && (
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <path d="m5 22 19-16 19 16" />
                  <path d="M10 19v23h28V19" />
                  <path d="M19 42V29h10v13" />
                  <path d="M16 23h16" />
                  <path d="M34 11h5v8" />
                </svg>
              )}

              {stat.icon === "sparkles" && (
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <path d="m24 5 3.5 12.5L40 21l-12.5 3.5L24 37l-3.5-12.5L8 21l12.5-3.5L24 5Z" />
                  <path d="m39 31 1.8 5.2L46 38l-5.2 1.8L39 45l-1.8-5.2L32 38l5.2-1.8L39 31Z" />
                  <path d="m10 4 1.5 4.5L16 10l-4.5 1.5L10 16l-1.5-4.5L4 10l4.5-1.5L10 4Z" />
                </svg>
              )}

            </div>
          </div>

          <span class="ft-stat-number">{stat.number}</span>

          <h3>{stat.label}</h3>

          <p>{stat.detail}</p>

          <span class="ft-stat-index">
            0{index + 1}
          </span>

        </article>
      ))}

    </div>

  </div>

</section>

<style>

/* =========================================
   FOREST TRAILS — 3D STATS SECTION
   DESKTOP
========================================= */

.ft-stats {
  position: relative;
  padding: 90px 5%;
  background: #f8f6f0;
  overflow: hidden;
}

.ft-stats-container {
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
}

/* Four Cards */

.ft-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 25px;
  perspective: 1400px;
}

/* Card */

.ft-stat-card {
  position: relative;
  min-width: 0;
  min-height: 285px;

  padding: 32px 20px 28px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;

  text-align: center;

  background: linear-gradient(
    145deg,
    #ffffff 0%,
    #fbfaf6 65%,
    #f0ece3 100%
  );

  border: 1px solid rgba(177, 151, 107, 0.19);

  box-shadow:
    0 3px 8px rgba(35, 47, 38, 0.07),
    0 12px 25px rgba(35, 47, 38, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 1);

  transform: translateY(0);

  transition:
    transform 0.4s ease,
    box-shadow 0.4s ease,
    border-color 0.4s ease;
}

.ft-stat-card:hover {
  transform: translateY(-9px) rotateX(2deg);

  border-color: rgba(177, 151, 107, 0.48);

  box-shadow:
    0 8px 15px rgba(35, 47, 38, 0.08),
    0 22px 38px rgba(35, 47, 38, 0.13),
    inset 0 1px 0 #fff;
}

/* Floating Icon */

.ft-stat-icon-wrap {
  width: 86px;
  height: 86px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 19px;
  border-radius: 50%;

  background: linear-gradient(
    145deg,
    #ffffff,
    #eeeae1
  );

  box-shadow:
    5px 5px 12px rgba(36, 50, 39, 0.12),
    -5px -5px 12px rgba(255, 255, 255, 0.95),
    inset 0 1px 2px rgba(255, 255, 255, 1);
}

.ft-stat-icon {
  width: 39px;
  height: 39px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.ft-stat-icon svg {
  width: 100%;
  height: 100%;

  stroke: #314638;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* Number */

.ft-stat-number {
  display: block;

  color: #a88752;

  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(34px, 3.4vw, 49px);
  font-weight: 600;
  line-height: 1;

  margin-bottom: 12px;
}

/* Text */

.ft-stat-card h3 {
  margin: 0;

  color: #26392e;

  font-family: "DM Sans", sans-serif;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.5;
}

.ft-stat-card p {
  max-width: 210px;

  margin: 8px 0 0;

  color: #77776e;
  font-size: 11px;
  line-height: 1.7;
}

/* Card Index */

.ft-stat-index {
  position: absolute;
  right: 15px;
  bottom: 12px;

  color: rgba(168, 135, 82, 0.35);

  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 13px;
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 1024px) {

  .ft-stats {
    padding: 75px 4%;
  }

  .ft-stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .ft-stat-card {
    min-height: 260px;
  }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 600px) {

  .ft-stats {
    padding: 65px 18px 55px;
  }

  .ft-stats-container {
    width: 100%;
  }

  /* Two cards per row */

  .ft-stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    perspective: none;
  }

  /* Cards */

  .ft-stat-card {
    width: 100%;
    min-width: 0;
    min-height: 225px;

    padding: 22px 10px 25px;

    border-radius: 3px;

    box-shadow:
      0 3px 8px rgba(35, 47, 38, 0.08),
      0 8px 18px rgba(35, 47, 38, 0.06);

    transform: none;
  }

  .ft-stat-card:hover {
    transform: none;
  }

  /* Icons */

  .ft-stat-icon-wrap {
    width: 65px;
    height: 65px;

    margin-bottom: 18px;

    box-shadow:
      3px 4px 10px rgba(36, 50, 39, 0.12),
      -3px -3px 9px rgba(255, 255, 255, 0.9);
  }

  .ft-stat-icon {
    width: 29px;
    height: 29px;
  }

  /* Numbers */

  .ft-stat-number {
    font-size: clamp(27px, 7vw, 36px);
    line-height: 1;
    margin-bottom: 10px;
    white-space: nowrap;
  }

  /* Labels */

  .ft-stat-card h3 {
    font-size: 12px;
    line-height: 1.5;
    font-weight: 600;
  }

  .ft-stat-card p {
    font-size: 10px;
    line-height: 1.6;
    margin-top: 6px;
  }

  /* Card number */

  .ft-stat-index {
    right: 10px;
    bottom: 8px;
    font-size: 11px;
  }

}


/* =========================================
   EXTRA SMALL MOBILE
========================================= */

@media (max-width: 360px) {

  .ft-stats {
    padding-left: 13px;
    padding-right: 13px;
  }

  .ft-stats-grid {
    gap: 10px;
  }

  .ft-stat-card {
    min-height: 210px;
    padding: 19px 7px 23px;
  }

  .ft-stat-icon-wrap {
    width: 58px;
    height: 58px;
  }

  .ft-stat-number {
    font-size: 27px;
  }

  .ft-stat-card h3 {
    font-size: 11px;
  }

  .ft-stat-card p {
    font-size: 9px;
  }

}


/* =========================================
   ACCESSIBILITY
========================================= */

@media (prefers-reduced-motion: reduce) {

  .ft-stat-card {
    transition: none;
  }

  .ft-stat-card:hover {
    transform: none;
  }

}

</style>
