
---
const amenities = [
  {
    name: "Infinity Swimming Pool",
    category: "LEISURE & RELAXATION",
    description: "Take a refreshing pause from the everyday and enjoy moments of relaxation by the water.",
    image: "/images/amenities/swimming-pool.webp",
    alt: "Infinity swimming pool",
  },
  {
    name: "Fully Equipped Gym",
    category: "WELLNESS & FITNESS",
    description: "Make room for movement, fitness and a routine that keeps you active.",
    image: "/images/amenities/gym.webp",
    alt: "Fitness gym",
  },
  {
    name: "Equestrian Centre",
    category: "UNIQUE EXPERIENCES",
    description: "Explore a distinctive recreational experience with equestrian activities.",
    image: "/images/amenities/equestrian.webp",
    alt: "Equestrian centre",
  },
  {
    name: "Sports Facilities",
    category: "SPORTS & RECREATION",
    description: "Find more opportunities to play, participate and enjoy your favourite sports.",
    image: "/images/amenities/sports.webp",
    alt: "Sports facilities",
  },
  {
    name: "The Cliff Lifestyle Club",
    category: "SOCIAL & COMMUNITY",
    description: "A setting for leisure, conversations and spending time together.",
    image: "/images/amenities/cliff-club.webp",
    alt: "The Cliff lifestyle club",
  },
  {
    name: "Open Amphitheatre",
    category: "OUTDOOR EXPERIENCES",
    description: "An open-air setting for shared moments and community gatherings.",
    image: "/images/amenities/amphitheatre.webp",
    alt: "Open amphitheatre",
  },
];
---

<section class="ft-amenities" id="amenities">
  <div class="ft-amenities-inner">

    <!-- HEADING -->
    <div class="ft-amenities-heading">
      <div>
        <span class="ft-amenities-eyebrow">LIFE BEYOND YOUR HOME</span>
        <h2>
          More than a home.
          <em>A world to experience.</em>
        </h2>
      </div>

      <p>
        From moments of quiet relaxation to experiences that
        bring people together, discover the many ways to enjoy
        life beyond your doorstep.
      </p>
    </div>

    <!-- 3D AMENITY CAROUSEL -->
    <div class="ft-amenity-experience" data-amenity-deck>

      <div class="ft-deck-topline">
        <span>EXPLORE THE EXPERIENCES</span>

        <div class="ft-deck-counter">
          <strong data-deck-current>01</strong>
          <span>/ 06</span>
        </div>
      </div>

      <div
        class="ft-deck-stage"
        data-deck-stage
        tabindex="0"
        aria-label="Explore amenities. Swipe, drag or use arrow keys."
      >

        {amenities.map((amenity, index) => (
          <article
            class:list={[
              "ft-deck-card",
              { "is-active": index === 0 },
            ]}
            data-deck-card
            data-index={index}
            aria-hidden={index !== 0 ? "true" : "false"}
          >

            <div class="ft-deck-image-fallback">
              <span>FOREST TRAILS</span>
            </div>

            <img
              src={amenity.image}
              alt={amenity.alt}
              loading={index === 0 ? "eager" : "lazy"}
              draggable="false"
            />

            <div class="ft-deck-shade"></div>

            <div class="ft-deck-card-top">
              <span>{amenity.category}</span>
              <span>{String(index + 1).padStart(2, "0")}</span>
            </div>

            <div class="ft-deck-card-content">
              <span class="ft-deck-label">DISCOVER FOREST TRAILS</span>
              <h3>{amenity.name}</h3>
              <p>{amenity.description}</p>
              <span class="ft-deck-link">
                EXPLORE EXPERIENCE <i>↗</i>
              </span>
            </div>

          </article>
        ))}

        <button
          class="ft-deck-arrow ft-deck-prev"
          type="button"
          aria-label="Previous amenity"
        >←</button>

        <button
          class="ft-deck-arrow ft-deck-next"
          type="button"
          aria-label="Next amenity"
        >→</button>

      </div>

      <!-- COMPACT FOOTER -->
      <div class="ft-deck-footer">

        <span class="ft-deck-instruction">
          <span>↔</span> Swipe to explore
        </span>

        <div class="ft-deck-pagination">
          {amenities.map((amenity, index) => (
            <button
              type="button"
              class:list={[
                "ft-deck-dot",
                { "is-active": index === 0 },
              ]}
              data-deck-dot={index}
              aria-label={`Show ${amenity.name}`}
              aria-current={index === 0 ? "true" : undefined}
            ></button>
          ))}
        </div>

        <span class="ft-deck-total">06 EXPERIENCES</span>

      </div>
    </div>

  </div>
</section>

<style is:global>
.ft-amenities {
  --amenity-cream: #f7f3eb;
  --amenity-dark: #102c1e;
  --amenity-brown: #68432c;
  --amenity-gold: #c39a58;

  position: relative;
  width: 100%;
  overflow: hidden;
  padding: 85px 0 65px;
  background: var(--amenity-cream);
  color: #28251f;
  font-family: "DM Sans", sans-serif;
}

.ft-amenities *,
.ft-amenities *::before,
.ft-amenities *::after {
  box-sizing: border-box;
}

.ft-amenities-inner {
  width: min(1500px, 90%);
  margin: 0 auto;
}

/* HEADING */

.ft-amenities-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 45px;
  margin-bottom: 36px;
}

.ft-amenities-eyebrow {
  display: block;
  margin-bottom: 15px;
  color: var(--amenity-gold);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 3px;
}

.ft-amenities-heading h2 {
  max-width: 760px;
  margin: 0;
  color: #2a251f;
  font: 500 clamp(42px, 4.8vw, 64px)/1.02
    "Cormorant Garamond", Georgia, serif;
  letter-spacing: -1px;
}

.ft-amenities-heading h2 em {
  display: block;
  color: var(--amenity-brown);
  font-weight: 400;
}

.ft-amenities-heading > p {
  max-width: 350px;
  margin: 0 0 5px;
  color: #777066;
  font-size: 12px;
  line-height: 1.85;
}

/* CAROUSEL WRAPPER */

.ft-amenity-experience {
  padding: 18px 0 12px;
  border-top: 1px solid #e4dacb;
  border-bottom: 1px solid #e4dacb;
}

.ft-deck-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.ft-deck-topline > span {
  color: var(--amenity-gold);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2px;
}

.ft-deck-counter {
  display: flex;
  align-items: baseline;
  gap: 8px;
  color: #a59a8c;
  font: 13px "Cormorant Garamond", Georgia, serif;
}

.ft-deck-counter strong {
  color: var(--amenity-brown);
  font-size: 25px;
  font-weight: 500;
}

/* 3D STAGE */

.ft-deck-stage {
  position: relative;
  width: 100%;
  height: 500px;
  perspective: 1400px;
  perspective-origin: 50% 45%;
  transform-style: preserve-3d;
  isolation: isolate;
  cursor: grab;
  user-select: none;
  -webkit-user-select: none;
  touch-action: pan-y;
}

.ft-deck-stage:active {
  cursor: grabbing;
}

/* CARD BASE */

.ft-deck-card {
  position: absolute;
  top: 0;
  left: 50%;
  width: 64%;
  height: 100%;
  overflow: hidden;
  border: 1px solid #d9cbb7;
  border-radius: 5px;
  background: #cfc8bb;
  box-shadow: 0 22px 60px #2b21172a;
  transform-style: preserve-3d;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition:
    transform .7s cubic-bezier(.2,.75,.25,1),
    opacity .55s ease,
    filter .7s ease,
    visibility .7s;
  will-change: transform, opacity;
}

/* ACTIVE */

.ft-deck-card.is-active {
  z-index: 10;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform:
    translateX(-50%)
    translateZ(90px)
    rotateY(0)
    scale(1);
  filter: none;
}

/* LEFT */

.ft-deck-card.is-prev {
  z-index: 8;
  opacity: .88;
  visibility: visible;
  pointer-events: auto;
  transform:
    translateX(-111%)
    translateY(22px)
    translateZ(-150px)
    rotateY(22deg)
    scale(.82);
  filter: brightness(.75);
}

/* RIGHT */

.ft-deck-card.is-next {
  z-index: 8;
  opacity: .88;
  visibility: visible;
  pointer-events: auto;
  transform:
    translateX(11%)
    translateY(22px)
    translateZ(-150px)
    rotateY(-22deg)
    scale(.82);
  filter: brightness(.75);
}

/* FAR LEFT */

.ft-deck-card.is-far-prev {
  z-index: 5;
  opacity: .35;
  visibility: visible;
  transform:
    translateX(-150%)
    translateY(45px)
    translateZ(-300px)
    rotateY(28deg)
    scale(.68);
  filter: brightness(.55) blur(1px);
}

/* FAR RIGHT */

.ft-deck-card.is-far-next {
  z-index: 5;
  opacity: .35;
  visibility: visible;
  transform:
    translateX(50%)
    translateY(45px)
    translateZ(-300px)
    rotateY(-28deg)
    scale(.68);
  filter: brightness(.55) blur(1px);
}

/* HIDDEN */

.ft-deck-card.is-hidden {
  z-index: 0;
  opacity: 0;
  visibility: hidden;
  transform: translateX(-50%) translateZ(-450px) scale(.5);
}

/* IMAGE FALLBACK */

.ft-deck-image-fallback {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(145deg, #b9b19f, #6b776b 65%, #1c3427);
  color: #ffffffa0;
  font: 12px "Cormorant Garamond", Georgia, serif;
  letter-spacing: 4px;
}

.ft-deck-card > img {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  pointer-events: none;
  -webkit-user-drag: none;
}

.ft-deck-card > img.image-failed {
  display: none;
}

.ft-deck-shade {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(
    180deg,
    #101b1710 0%,
    transparent 34%,
    #101b1760 62%,
    #101b17e8 100%
  );
  pointer-events: none;
}

/* CARD TOP */

.ft-deck-card-top {
  position: absolute;
  top: 22px;
  right: 25px;
  left: 25px;
  z-index: 3;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
}

.ft-deck-card-top span:first-child {
  padding: 8px 11px;
  border: 1px solid #ffffff65;
  background: #102c1e40;
  font-size: 8px;
  font-weight: 600;
  letter-spacing: 1.8px;
  backdrop-filter: blur(8px);
}

.ft-deck-card-top span:last-child {
  font: 20px "Cormorant Garamond", Georgia, serif;
}

/* CARD TEXT */

.ft-deck-card-content {
  position: absolute;
  z-index: 3;
  right: 40px;
  bottom: 38px;
  left: 40px;
  color: white;
  transform: translateZ(25px);
}

.ft-deck-label {
  display: block;
  margin-bottom: 12px;
  color: #e4c38e;
  font-size: 8px;
  font-weight: 600;
  letter-spacing: 2.5px;
}

.ft-deck-card-content h3 {
  max-width: 650px;
  margin: 0 0 10px;
  color: #fff;
  font: 500 clamp(35px, 4vw, 55px)/1
    "Cormorant Garamond", Georgia, serif;
}

.ft-deck-card-content p {
  max-width: 460px;
  margin: 0;
  color: #ffffffdc;
  font-size: 12px;
  line-height: 1.75;
}

.ft-deck-link {
  display: inline-flex;
  align-items: center;
  gap: 15px;
  margin-top: 20px;
  padding-bottom: 7px;
  border-bottom: 1px solid #d5b783;
  color: #f0d6a9;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.8px;
}

.ft-deck-link i {
  font-size: 16px;
  font-style: normal;
}

/* ARROWS */

.ft-deck-arrow {
  position: absolute;
  top: 50%;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 39px;
  height: 39px;
  border: 1px solid #ffffff90;
  border-radius: 50%;
  background: #f8f5ef;
  color: var(--amenity-dark);
  font-size: 18px;
  cursor: pointer;
  transition: background .25s, color .25s, transform .25s;
}

.ft-deck-arrow:hover {
  background: var(--amenity-dark);
  color: white;
  transform: scale(1.08);
}

.ft-deck-prev {
  left: 15%;
}

.ft-deck-next {
  right: 15%;
}

/* FOOTER */

.ft-deck-footer {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 15px;
  padding: 19px 3px 2px;
}

.ft-deck-instruction {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #82796e;
  font-size: 10px;
}

.ft-deck-instruction > span {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border: 1px solid #d9cbb7;
  border-radius: 50%;
  color: var(--amenity-brown);
  font-size: 14px;
}

.ft-deck-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
}

.ft-deck-dot {
  width: 6px;
  height: 6px;
  padding: 0;
  border: 0;
  border-radius: 20px;
  background: #cfc3b1;
  cursor: pointer;
  transition: width .3s, background .3s;
}

.ft-deck-dot.is-active {
  width: 23px;
  background: var(--amenity-brown);
}

.ft-deck-total {
  justify-self: end;
  color: #9b8c7a;
  font-size: 8px;
  letter-spacing: 1.8px;
}

/* TABLET */

@media (max-width: 1000px) {
  .ft-deck-stage {
    height: 460px;
  }

  .ft-deck-card {
    width: 72%;
  }

  .ft-deck-prev {
    left: 8%;
  }

  .ft-deck-next {
    right: 8%;
  }
}

/* MOBILE */

@media (max-width: 700px) {
  .ft-amenities {
    padding: 65px 0 45px;
  }

  .ft-amenities-inner {
    width: 92%;
  }

  .ft-amenities-heading {
    display: block;
    margin-bottom: 30px;
  }

  .ft-amenities-heading h2 {
    font-size: 43px;
  }

  .ft-amenities-heading > p {
    margin-top: 15px;
    font-size: 11px;
  }

  .ft-deck-stage {
    height: 420px;
    perspective: 1000px;
  }

  .ft-deck-card {
    width: 78%;
  }

  .ft-deck-card.is-active {
    transform:
      translateX(-50%)
      translateZ(65px)
      rotateY(0)
      scale(1);
  }

  .ft-deck-card.is-prev {
    transform:
      translateX(-105%)
      translateY(17px)
      translateZ(-100px)
      rotateY(17deg)
      scale(.83);
  }

  .ft-deck-card.is-next {
    transform:
      translateX(5%)
      translateY(17px)
      translateZ(-100px)
      rotateY(-17deg)
      scale(.83);
  }

  .ft-deck-card.is-far-prev {
    transform:
      translateX(-145%)
      translateY(30px)
      translateZ(-220px)
      rotateY(22deg)
      scale(.7);
  }

  .ft-deck-card.is-far-next {
    transform:
      translateX(45%)
      translateY(30px)
      translateZ(-220px)
      rotateY(-22deg)
      scale(.7);
  }

  .ft-deck-card-top {
    top: 15px;
    right: 15px;
    left: 15px;
  }

  .ft-deck-card-top span:first-child {
    padding: 7px 8px;
    font-size: 7px;
    letter-spacing: 1px;
  }

  .ft-deck-card-content {
    right: 19px;
    bottom: 28px;
    left: 19px;
  }

  .ft-deck-card-content h3 {
    font-size: 35px;
  }

  .ft-deck-card-content p {
    font-size: 10px;
  }

  .ft-deck-label,
  .ft-deck-link {
    font-size: 7px;
  }

  .ft-deck-arrow {
    top: auto;
    bottom: 12px;
    width: 34px;
    height: 34px;
    font-size: 16px;
  }

  .ft-deck-prev {
    left: 10px;
  }

  .ft-deck-next {
    right: 10px;
  }

  .ft-deck-footer {
    grid-template-columns: 1fr auto;
    padding-top: 15px;
  }

  .ft-deck-instruction {
    font-size: 9px;
  }

  .ft-deck-total {
    display: none;
  }

  .ft-deck-dot {
    width: 5px;
    height: 5px;
  }

  .ft-deck-dot.is-active {
    width: 17px;
  }
}

@media (max-width: 380px) {
  .ft-deck-stage {
    height: 385px;
  }

  .ft-deck-card {
    width: 83%;
  }

  .ft-deck-card-content h3 {
    font-size: 31px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ft-deck-card,
  .ft-deck-arrow,
  .ft-deck-dot {
    transition: none !important;
  }
}
</style>

<script>
function initAmenityDeck() {
  document.querySelectorAll("[data-amenity-deck]").forEach((deck) => {
    if (deck.dataset.initialized === "true") return;
    deck.dataset.initialized = "true";

    const stage = deck.querySelector("[data-deck-stage]");
    const cards = Array.from(deck.querySelectorAll("[data-deck-card]"));
    const dots = Array.from(deck.querySelectorAll("[data-deck-dot]"));
    const currentLabel = deck.querySelector("[data-deck-current]");
    const previous = deck.querySelector(".ft-deck-prev");
    const next = deck.querySelector(".ft-deck-next");

    if (!stage || !cards.length) return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );

    const interval = 4200;

    let activeIndex = 0;
    let autoplay = null;
    let startX = 0;
    let startY = 0;
    let pointerDown = false;
    let wheelLocked = false;
    let wheelDelta = 0;
    let wheelTimer = null;

    const wrap = (index) =>
      (index + cards.length) % cards.length;

    function render(index) {
      activeIndex = wrap(index);

      cards.forEach((card, i) => {
        const difference =
          (i - activeIndex + cards.length) % cards.length;

        card.classList.remove(
          "is-active",
          "is-prev",
          "is-next",
          "is-far-prev",
          "is-far-next",
          "is-hidden"
        );

        if (difference === 0) {
          card.classList.add("is-active");
        } else if (difference === 1) {
          card.classList.add("is-next");
        } else if (difference === cards.length - 1) {
          card.classList.add("is-prev");
        } else if (difference === 2) {
          card.classList.add("is-far-next");
        } else if (difference === cards.length - 2) {
          card.classList.add("is-far-prev");
        } else {
          card.classList.add("is-hidden");
        }

        card.setAttribute(
          "aria-hidden",
          String(difference !== 0)
        );
      });

      dots.forEach((dot, i) => {
        const active = i === activeIndex;

        dot.classList.toggle("is-active", active);

        if (active) {
          dot.setAttribute("aria-current", "true");
        } else {
          dot.removeAttribute("aria-current");
        }
      });

      if (currentLabel) {
        currentLabel.textContent =
          String(activeIndex + 1).padStart(2, "0");
      }
    }

    function goNext() {
      render(activeIndex + 1);
      restartAutoplay();
    }

    function goPrevious() {
      render(activeIndex - 1);
      restartAutoplay();
    }

    function startAutoplay() {
      stopAutoplay();

      if (reducedMotion.matches || document.hidden) return;

      autoplay = window.setInterval(() => {
        render(activeIndex + 1);
      }, interval);
    }

    function stopAutoplay() {
      if (autoplay !== null) {
        window.clearInterval(autoplay);
        autoplay = null;
      }
    }

    function restartAutoplay() {
      startAutoplay();
    }

    /* BUTTONS */

    previous.addEventListener("click", goPrevious);
    next.addEventListener("click", goNext);

    /* DOTS */

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        render(index);
        restartAutoplay();
      });
    });

    /* CLICK SIDE CARD */

    cards.forEach((card, index) => {
      card.addEventListener("click", () => {
        if (index !== activeIndex) {
          render(index);
          restartAutoplay();
        }
      });
    });

    /* TOUCH SWIPE */

    stage.addEventListener("touchstart", (event) => {
      const touch = event.changedTouches[0];
      startX = touch.clientX;
      startY = touch.clientY;
    }, { passive: true });

    stage.addEventListener("touchend", (event) => {
      const touch = event.changedTouches[0];
      const deltaX = touch.clientX - startX;
      const deltaY = touch.clientY - startY;

      if (Math.max(Math.abs(deltaX), Math.abs(deltaY)) < 35) return;

      if (Math.abs(deltaX) > Math.abs(deltaY)) {
        deltaX < 0 ? goNext() : goPrevious();
      } else {
        deltaY < 0 ? goNext() : goPrevious();
      }
    }, { passive: true });

    /* MOUSE DRAG */

    stage.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;

      startX = event.clientX;
      startY = event.clientY;
      pointerDown = true;
    });

    stage.addEventListener("pointerup", (event) => {
      if (!pointerDown) return;

      pointerDown = false;

      const deltaX = event.clientX - startX;
      const deltaY = event.clientY - startY;

      if (Math.max(Math.abs(deltaX), Math.abs(deltaY)) < 40) return;

      if (Math.abs(deltaX) > Math.abs(deltaY)) {
        deltaX < 0 ? goNext() : goPrevious();
      } else {
        deltaY < 0 ? goNext() : goPrevious();
      }
    });

    stage.addEventListener("pointercancel", () => {
      pointerDown = false;
    });

    /* MOUSE WHEEL */

    stage.addEventListener("wheel", (event) => {
      if (wheelLocked) return;

      const delta =
        Math.abs(event.deltaY) > Math.abs(event.deltaX)
          ? event.deltaY
          : event.deltaX;

      if (Math.abs(delta) < 10) return;

      event.preventDefault();
      wheelDelta += delta;

      clearTimeout(wheelTimer);

      wheelTimer = window.setTimeout(() => {
        if (Math.abs(wheelDelta) > 35) {
          wheelDelta > 0 ? goNext() : goPrevious();

          wheelLocked = true;

          window.setTimeout(() => {
            wheelLocked = false;
          }, 550);
        }

        wheelDelta = 0;
      }, 50);
    }, { passive: false });

    /* PAUSE WHEN TAB IS HIDDEN */

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    });

    /* IMAGE FALLBACK */

    cards.forEach((card) => {
      const img = card.querySelector("img");

      if (!img) return;

      img.addEventListener("error", () => {
        img.classList.add("image-failed");
      }, { once: true });
    });

    /* START */

    render(0);
    startAutoplay();
  });
}

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", initAmenityDeck, {
    once: true
  });
} else {
  initAmenityDeck();
}

document.addEventListener("astro:page-load", initAmenityDeck);
</script>
