
---
const residences = [
  { number: "01", name: "Everglades" },
  { number: "02", name: "Highgardens" },
  { number: "03", name: "The Canopy" },
  { number: "04", name: "Athashri" },
  { number: "05", name: "The Cove" },
];
---

<section class="hero-section" aria-labelledby="hero-title">

  <!-- Responsive Background Image -->
  <div class="hero-background">
    <picture>
      <source
        media="(max-width: 768px)"
        srcset="/images/hero/forest-trails-hero-mobile1.png"
      />

      <img
        src="/images/hero/forest-trails-hero4.png"
        alt="Landscaped township, residences and greenery at Paranjape Forest Trails, Bhugaon"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        width="1920"
        height="1080"
      />
    </picture>
  </div>

  <!-- Image Overlay -->
  <div class="hero-overlay"></div>

  <!-- Hero Content -->
  <div class="hero-inner">

    <!-- Main Copy -->
    <div class="hero-copy">



      <h1 id="hero-title">
        A little more room
        <span>for life.</span>
      </h1>

      <p class="hero-description">
        More open spaces, greener surroundings and a place
        where everyday moments have room to unfold.
        Discover a thoughtfully planned residential township
        at Forest Trails, Bhugaon.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-actions">

        <a href="#contact" class="hero-primary-btn">
          Explore Residences
          <span aria-hidden="true">↗</span>
        </a>

        <a href="#overview" class="hero-text-link">
          Discover Forest Trails
          <span aria-hidden="true">→</span>
        </a>

      </div>

    </div>

        </div>


</section>

<style>

/* =========================================
   HERO — BASE / DESKTOP
========================================= */

.hero-section {
  position: relative;
  width: 100%;
  min-height: 740px;
  height: calc(100svh - 112px);
  max-height: 1000px;
  overflow: hidden;
  display: flex;
  align-items: center;
  background: #17251e;
  color: #fff;
}

/* Background */

.hero-background {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero-background picture,
.hero-background img {
  display: block;
  width: 100%;
  height: 100%;
}

.hero-background img {
  object-fit: cover;
  object-position: center center;
}

/* Overlay */

.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;

  background:
    linear-gradient(
      90deg,
      rgba(12, 25, 20, 0.80) 0%,
      rgba(12, 25, 20, 0.57) 37%,
      rgba(12, 25, 20, 0.15) 72%,
      rgba(12, 25, 20, 0.12) 100%
    ),
    linear-gradient(
      0deg,
      rgba(10, 22, 17, 0.55) 0%,
      transparent 38%
    );
}

/* Main Container */

.hero-inner {
  position: relative;
  z-index: 2;

  width: 100%;
  max-width: 1600px;
  height: 100%;

  margin: 0 auto;
  padding: 90px 6% 110px;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

/* Hero Copy */

.hero-copy {
  width: 100%;
  max-width: 790px;
}

.hero-kicker {
  margin: 0 0 24px;

  color: #d9b77e;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 3.5px;
  line-height: 1.6;
}

/* Heading */

.hero-copy h1 {
  max-width: 900px;

  margin: 0;

  color: #fffaf1;
  font-family: "Cormorant Garamond", Georgia, serif;

  font-size: clamp(76px, 7vw, 118px);
  font-weight: 400;
  line-height: 0.98;
  letter-spacing: -2.5px;
}

.hero-copy h1 span {
  display: block;

  color: #dfc18f;
  font-style: italic;
}

/* Description */

.hero-description {
  max-width: 660px;

  margin: 34px 0 0;

  color: rgba(255, 255, 255, 0.94);

  font-size: 15px;
  font-weight: 400;
  line-height: 2;
}

/* CTA Buttons */

.hero-actions {
  display: flex;
  align-items: center;
  gap: 34px;

  margin-top: 38px;
}

.hero-primary-btn {
  min-height: 60px;
  padding: 0 28px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 32px;

  background: #bd9d6b;
  color: #fff;

  font-size: 12px;
  font-weight: 600;
  text-decoration: none;

  transition: background 0.3s ease;
}

.hero-primary-btn:hover {
  background: #a98756;
}

.hero-primary-btn span {
  font-size: 17px;
}

.hero-text-link {
  min-height: 45px;

  display: inline-flex;
  align-items: center;
  gap: 13px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.55);

  color: #fff;
  font-size: 12px;
  font-weight: 500;
  text-decoration: none;

  transition: opacity 0.3s ease;
}

.hero-text-link:hover {
  opacity: 0.7;
}

/* Residence Collection */

.hero-project-index {
  position: absolute;

  left: 6%;
  right: 6%;
  bottom: 35px;

  padding-top: 17px;

  border-top: 1px solid rgba(255, 255, 255, 0.4);
}

.hero-index-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 15px;
}

.hero-index-heading span {
  color: #e1c28e;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 2px;
}

.hero-residences {
  display: flex;
  align-items: center;
  gap: 0;
}

.hero-residence {
  flex: 1;

  display: flex;
  align-items: center;
  gap: 13px;

  padding: 0 22px;

  border-right: 1px solid rgba(255, 255, 255, 0.35);
}

.hero-residence:first-child {
  padding-left: 0;
}

.hero-residence:last-child {
  border-right: 0;
}

.residence-number {
  color: #d8b77e;
  font-size: 10px;
}

.residence-name {
  color: #fffaf1;

  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 20px;
  font-weight: 500;

  white-space: nowrap;
}

/* Bottom Note */

.hero-bottom-note {
  position: absolute;
  z-index: 2;

  right: 6%;
  bottom: 45px;

  display: none;

  align-items: center;
  gap: 12px;

  color: #e4c895;
  font-size: 9px;
  letter-spacing: 2px;
}

.hero-bottom-line {
  width: 35px;
  height: 1px;
  background: #e4c895;
}


/* =========================================
   TABLET
========================================= */

@media (min-width: 769px) and (max-width: 1100px) {

  .hero-section {
    min-height: 700px;
  }

  .hero-inner {
    padding-left: 5%;
    padding-right: 5%;
  }

  .hero-copy {
    max-width: 650px;
  }

  .hero-copy h1 {
    font-size: clamp(68px, 8vw, 90px);
  }

  .hero-description {
    max-width: 550px;
  }

  .hero-project-index {
    left: 5%;
    right: 5%;
  }

  .hero-residence {
    padding: 0 12px;
    gap: 8px;
  }

  .residence-name {
    font-size: 17px;
  }
}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 768px) {

  .hero-section {
    width: 100%;
    height: auto;
    min-height: calc(100svh - 80px);
    max-height: none;

    display: flex;
    flex-direction: column;
    align-items: stretch;

    overflow: hidden;
  }

  /* Mobile Background */

  .hero-background img {
    object-position: center center;
  }

  /* Mobile Overlay */

  .hero-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(13, 26, 20, 0.30) 0%,
        rgba(13, 26, 20, 0.42) 28%,
        rgba(13, 26, 20, 0.78) 58%,
        rgba(13, 26, 20, 0.94) 100%
      );
  }

  /* Main Content */

  .hero-inner {
    width: 100%;
    height: auto;
    min-height: calc(100svh - 80px);

    padding: 100px 22px 34px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;

    gap: 52px;
  }

  .hero-copy {
    width: 100%;
    max-width: 480px;
    margin: 0;
  }

  /* Kicker */

  .hero-kicker {
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: 2.5px;

    margin: 0 0 19px;
  }

  /* Heading */

  .hero-copy h1 {
    width: 100%;
    max-width: 430px;

    font-size: clamp(43px, 10.5vw, 56px);
    line-height: 1.04;
    letter-spacing: -1.6px;

    margin: 0;
  }

  .hero-copy h1 span {
    display: block;
    margin-top: 2px;
  }

  /* Description */

  .hero-description {
    max-width: 390px;

    font-size: 12.5px;
    line-height: 1.8;

    margin: 20px 0 0;
  }

  /* Buttons */

  .hero-actions {
    width: 100%;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    gap: 13px;
    margin-top: 25px;
  }

  .hero-primary-btn {
    width: 100%;
    min-height: 52px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;

    padding: 0 18px;
    font-size: 11px;
  }

  .hero-text-link {
    min-height: 42px;

    display: inline-flex;
    align-items: center;
    gap: 12px;

    font-size: 11px;
  }

  /* Residence Collection */

  .hero-project-index {
    position: relative;

    width: 100%;
    left: auto;
    right: auto;
    bottom: auto;

    margin: 0;
    padding-top: 20px;

    border-top: 1px solid rgba(255, 255, 255, 0.35);
  }

  .hero-index-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 10px;
    margin-bottom: 20px;
  }

  .hero-index-heading span {
    font-size: 8px;
    line-height: 1.6;
    letter-spacing: 1.3px;
  }

  .hero-index-heading span:last-child {
    text-align: right;
  }

  /* Horizontal Scroll */

  .hero-residences {
    display: flex;
    flex-wrap: nowrap;

    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;

    gap: 0;
    padding-bottom: 12px;

    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .hero-residences::-webkit-scrollbar {
    display: none;
  }

  .hero-residence {
    flex: 0 0 auto;
    min-width: 135px;

    padding: 0 18px;

    border-right: 1px solid rgba(255, 255, 255, 0.3);
  }

  .hero-residence:first-child {
    padding-left: 0;
  }

  .hero-residence:last-child {
    border-right: none;
  }

  .residence-number {
    display: block;
    font-size: 9px;
    margin-bottom: 9px;
    opacity: 0.75;
  }

  .residence-name {
    display: block;
    font-size: 14px;
    white-space: nowrap;
  }

  /* Hide Desktop Bottom Note */

  .hero-bottom-note {
    display: none;
  }

}


/* =========================================
   SMALL MOBILE
========================================= */

@media (max-width: 390px) {

  .hero-inner {
    padding-left: 20px;
    padding-right: 20px;
    gap: 42px;
  }

  .hero-copy h1 {
    font-size: 44px;
    letter-spacing: -1.4px;
  }

  .hero-description {
    font-size: 12px;
  }

  .hero-residence {
    min-width: 125px;
    padding-left: 14px;
    padding-right: 14px;
  }

}


/* =========================================
   SHORT MOBILE SCREENS
========================================= */

@media (max-width: 768px) and (max-height: 720px) {

  .hero-inner {
    padding-top: 65px;
    gap: 35px;
  }

  .hero-copy h1 {
    font-size: 42px;
  }

  .hero-description {
    margin-top: 15px;
  }

  .hero-actions {
    margin-top: 18px;
  }

}

</style>
